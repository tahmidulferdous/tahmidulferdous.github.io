---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";
import { isEnabled } from "../../data/site";

export async function getStaticPaths() {
  if (!isEnabled("blog")) return [];
  const posts = (await getCollection("blog")).filter((p) => !p.data.draft);
  const paths: any[] = [{ params: { slug: undefined } }];
  for (const entry of posts) {
    const slug = (entry as any).slug
      ? (entry as any).slug
      : (entry as any).id.replace(/\.mdx?$/, "");
    paths.push({ params: { slug }, props: { entry } });
  }
  return paths;
}

function slugFor(entry: { id: string; slug?: string }) {
  if ((entry as any).slug) return (entry as any).slug;
  return entry.id.replace(/\.mdx?$/, "");
}

function formatDate(d: Date) {
  return new Date(d).toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
}

const isIndex = Astro.params.slug === undefined;
let entry: any = (Astro.props as any).entry;
let posts: any[] = [];
let Content: any = null;
if (isIndex) {
  posts = (await getCollection("blog"))
    .filter((p) => !p.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
} else {
  const { Content: C } = await render(entry);
  Content = C;
}
---
{isIndex ? (
  <Base title="Blog">
    <h1>Blog</h1>
    <ul class="blog-list">
      {posts.map((post) => {
        const slug = slugFor(post);
        return (
          <li>
            <span>{formatDate(post.data.date)} — </span>
            <a href={`/blog/${slug}/`}>{post.data.title}</a>
            {post.data.description && <p>{post.data.description}</p>}
          </li>
        );
      })}
    </ul>
  </Base>
) : (
  <Base title={entry.data.title} description={entry.data.description}>
    <h1>{entry.data.title}</h1>
    <p>{formatDate(entry.data.date)}</p>
    {entry.data.tags && entry.data.tags.length > 0 && (
      <p>{entry.data.tags.join(", ")}</p>
    )}
    <Content />
    <p><a href="/blog/">Back to Blog</a></p>
  </Base>
)}
