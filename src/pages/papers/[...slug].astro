---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";
import { isEnabled } from "../../data/site";

export async function getStaticPaths() {
  if (!isEnabled("papers")) return [];
  return [{ params: { slug: undefined } }];
}

const STATUS_ORDER = ["published", "accepted", "under review", "preprint", "in preparation"];

const allPapers = (await getCollection("papers")).sort(
  (a, b) => b.data.year - a.data.year || (a.data.order ?? 0) - (b.data.order ?? 0),
);

const grouped = STATUS_ORDER.map((status) => ({
  status,
  items: allPapers.filter((p) => p.data.status === status),
})).filter((g) => g.items.length > 0);
---
<Base title="Papers">
  <h1>Papers</h1>
  {grouped.map((group) => (
    <>
      <h2>{group.status}</h2>
      <ul class="paper-list">
        {group.items.map((paper) => (
          <li>
            {paper.data.url ? (
              <a href={paper.data.url}>{paper.data.title}</a>
            ) : (
              <span>{paper.data.title}</span>
            )}
            <br />
            <span>{paper.data.authors}</span>
            {paper.data.venue && <span> · {paper.data.venue}</span>}
            <span> · {paper.data.year}</span>
            {(paper.data.pdf || paper.data.code) && (
              <span>
                {" "}
                {paper.data.pdf && <a href={paper.data.pdf}>[PDF]</a>}
                {paper.data.pdf && paper.data.code && <span> </span>}
                {paper.data.code && <a href={paper.data.code}>[Code]</a>}
              </span>
            )}
          </li>
        ))}
      </ul>
    </>
  ))}
</Base>
