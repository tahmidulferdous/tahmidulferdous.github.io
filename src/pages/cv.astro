---
import Base from "../layouts/Base.astro";
import { getEntry, render } from "astro:content";

const entry = await getEntry("pages", "cv");
if (!entry) throw new Error("Missing content: pages/cv");
const { Content } = await render(entry);
const title = entry.data.title || "CV";
---
<Base title={title}>
  <h1>{title}</h1>
  <Content />
</Base>
